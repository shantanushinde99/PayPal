# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEB_BASE=https://www.sandbox.paypal.com
PAYOUT_MODE=direct
# From: npx tsx --env-file=.env scripts/register-webhook.mts <public URL>
PAYPAL_WEBHOOK_ID=

# Google Gemini (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# KERNEL cloud browsers (onkernel.com)
KERNEL_API_KEY=

# Database and auth
DATABASE_URL=postgres://pod:pod@localhost:5433/pod
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
APP_URL=http://lvh.me:3000
AUTH_URL=http://lvh.me:3000

# Optional
GITHUB_READ_TOKEN=       # read-only token: 5,000 GitHub API calls/hour for repo checks instead of 60
AG_STUDIO_LICENSE_KEY=
REVIEW_WINDOW_MINUTES=
DEMO_PAYOUT_EMAIL=
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
